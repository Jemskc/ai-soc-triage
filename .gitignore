# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
*.egg
venv/
.venv/
env/

# Environment variables — never commit secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# HuggingFace model cache — too large for git
hf_cache/

# Generated analysis artefacts. These embed host names and account names from
# whatever telemetry was analysed, so they must not reach a public repo.
soc-sentinel/public/events.json
ai-soc-eval/lanl_results.json
ai-soc-eval/selftest/
ai-soc-triage/data/inventory.json

# LANL Cyber-1 dataset — 10.7GB of source telemetry, fetched not authored.
# redteam.txt.gz is the ground-truth label file; kept out too so the data and
# its labels stay together outside the repo.
*.txt.gz

# Process bookkeeping, not source
ai-soc-triage/output/*.pid
ai-soc-eval/*.pid
ai-soc-triage/output/supervisor.log
