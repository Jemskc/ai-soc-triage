.env
__pycache__/
*.pyc
.streamlit/

# Sample corpus — 51MB of EVTX, fetched separately
data/raw_logs/

# Knowledge base artifacts. All three are generated by scripts/build_kb.py from
# an upstream source the README documents fetching, so committing them would put
# ~49MB of derivable data in history for no benefit.
data/kb/enterprise-attack.json
data/kb/corpus.json
data/kb/embeddings.npy

# Analysis run artifacts — regenerated per run, and they embed host names and
# account names from whatever telemetry was analysed.
output/

# Provisional inventory inferred from telemetry — contains real asset names.
data/inventory.json
data/inbox/
