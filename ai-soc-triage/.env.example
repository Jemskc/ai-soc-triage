# Local HuggingFace model config
# Recommended: Qwen/Qwen2.5-14B-Instruct
# Also works:  meta-llama/Llama-3.1-8B-Instruct
LOCAL_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct
LOCAL_MAX_NEW_TOKENS=768

# Threat Intelligence API Keys (Optional - for automated IOC enrichment)
# Get free API keys from:
# - VirusTotal: https://www.virustotal.com/gui/my-apikey
# - AbuseIPDB: https://www.abuseipdb.com/api
# - Shodan: https://account.shodan.io/
# - WhoisXML API: https://whoisxmlapi.com/
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
WHOISXML_API_KEY=
